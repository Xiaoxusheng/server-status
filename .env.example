# ============================================================
# server-status 配置文件模板
#
# 用法：
#   Docker Compose : 复制为同目录 .env（已被 .gitignore/.dockerignore 排除，切勿提交）
#   systemd        : 复制为 /etc/server-status/server-status.env（root 属主、0600 权限）
#
# 所有密钥用  openssl rand -hex 32  生成，生成后保持不变：
#   更换 ENCRYPT_KEY 会导致已加密数据无法解密
#   更换 SIGNING_KEY / TOKEN_SECRET 等效于全体会话与下载令牌作废
# ============================================================

# ---------- 密钥（生产必填） ----------

# HMAC 签名密钥：会话 Cookie、分享密码 Cookie、私人空间入口签名
# 不设置时每次启动随机生成 → 重启后所有已签发 Cookie 全部失效（启动日志会告警）
SERVER_STATUS_SIGNING_KEY=

# AES-GCM 落盘加密密钥：用户/角色/令牌数据、私人手记、Shell 密码文件
# 不设置时回退内置默认值，等于数据可被任何拿到源码的人解密（启动日志会告警）
SERVER_STATUS_ENCRYPT_KEY=

# 下载令牌签名密钥（单独生成一份，勿与其他密钥复用）
SERVER_STATUS_DOWNLOAD_TOKEN_SECRET=

# ---------- 站点（可选，按需修改） ----------

# 对外访问域名：跨域白名单、Cookie Domain、证书探测显示都会用到
# 本机调试保持 localhost；生产改成你的域名（不要带 https:// 和端口）
#SERVER_STATUS_DOMAIN=localhost

# HTTPS 监听地址
#SERVER_STATUS_LISTEN_ADDR=:9000

# 数据根目录：模板（未单独指定时）、运行数据、日志、TLS 证书默认都在它下面
#SERVER_STATUS_HOME=/opt/server-status

# TLS 证书与私钥（默认 <数据根目录>/tls/cert.pem、key.pem）
#SERVER_STATUS_TLS_CERT=/opt/server-status/tls/cert.pem
#SERVER_STATUS_TLS_KEY=/opt/server-status/tls/key.pem

# 媒体文件目录（默认 <数据根目录>/media）
#SERVER_STATUS_MEDIA_DIR=/opt/server-status/media

# 随机媒体外链基地址：部署了独立公开静态服务器时填写（如 https://你的域名:8081/static/）
# 留空时自动回退为同源 /api/media 接口（会话鉴权，无需额外静态服务器）
#SERVER_STATUS_STATIC_BASE_URL=

# 额外跨域白名单 Origin，逗号分隔（反向代理地址、静态服务器地址等）
#SERVER_STATUS_EXTRA_ORIGINS=

# ---------- 可选功能 ----------

# 私人空间密码初始化：仅首次启动且未初始化过时生效（bcrypt 落库后此行即可删除）
#PRIVATE_NOTES_PASSWORD=

# Web Shell 二次认证密码的 bcrypt 哈希（设置后页面上的改密接口自动禁用）
# 生成：htpasswd -bnBC 10 "" '你的密码' | tr -d ':\n'
#SHELL_PASSWORD_HASH=

# ---------- 可选调优（保持默认即可） ----------

# Web Shell 并发与生命周期
#MAX_SHELLS_PER_USER=3
#MAX_SHELLS_GLOBAL=10
#SHELL_IDLE_TIMEOUT=30m
#SHELL_MAX_LIFETIME=12h
#SHELL_TOKEN_TTL=60s

# Trojan-Go 监控覆盖项（一般直接改 数据目录/config.json 的 trojan 段）
#SERVER_STATUS_TROJAN_ENABLED=false
#SERVER_STATUS_TROJAN_API_ADDR=127.0.0.1:10000
